        <mxCell id="m4" value="driver.execute_query(text, parameters_=params, database_=database(), routing_=&quot;r&quot;)" style="edgeStyle=none;html=1;endArrow=open;strokeColor=#9673A6;strokeWidth=1.5;dashed=0;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1">
