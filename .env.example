# weather-graph — environment template. Copy to .env (gitignored).

# Ollama backend for both BeeAI and Mellea
OLLAMA_HOST="http://127.0.0.1:11434"

# Model for the BeeAI RequirementAgent (BeeAI uses the "ollama:" prefix form)
AGENT_MODEL="ollama:granite4:micro"
# Same model for the Mellea session (Ollama's own model name, no prefix)
MELLEA_MODEL="granite4:micro"

# Optional BeeAI observability
# LOG_LEVEL="INFO"

# Weather graph storage backend: "memory" (default, parses model/*.ttl in-process, no external
# services) or "qlever" (queries a local QLever instance — see qlever/Qleverfile, `make qlever-index`
# / `make qlever-up`, and PLAN_WEATHER_QLEVER.md). Tests always use "memory" regardless of this value.
GRAPH_BACKEND="memory"
# Only used when GRAPH_BACKEND="qlever"; must match [server] PORT in qlever/Qleverfile.
QLEVER_ENDPOINT="http://localhost:7011"
