# weather-graph — environment template. Copy to .env (gitignored).

# Which agent backend answers NL weather questions (`uv run weather-graph` / `make run`):
#   "pydantic_ai" (default) - minimal typed agent, structured output straight into WeatherSparqlSpec
#   "langgraph"              - LangGraph variant, an explicit query->answer graph
#   "beeai"                  - opt-in legacy BeeAI + Mellea combo; requires `uv sync --extra beeai`
#                               first (see beeai-check / `make run-beeai`) -- demoted here because
#                               Mellea's repair loop makes it measurably slower than the above two.
AGENT_BACKEND="pydantic_ai"

# Ollama host shared by every backend above.
OLLAMA_HOST="http://127.0.0.1:11434"

# Plain Ollama model names, one var per backend so you can point the default and the variant at
# different models when comparing them (mirrors the existing AGENT_MODEL/MELLEA_MODEL split below).
PYDANTIC_AI_MODEL="granite4:micro"
LANGGRAPH_MODEL="granite4:micro"

# Only used when AGENT_BACKEND="beeai". Model for the BeeAI RequirementAgent (BeeAI uses the
# "ollama:" prefix form).
AGENT_MODEL="ollama:granite4:micro"
# Only used when AGENT_BACKEND="beeai". Same model for the Mellea session (Ollama's own model
# name, no prefix).
MELLEA_MODEL="granite4:micro"

# Optional BeeAI observability (AGENT_BACKEND="beeai" only)
# LOG_LEVEL="INFO"

# Weather graph storage backend: "memory" (default, parses model/*.ttl in-process, no external
# services) or "qlever" (queries a local QLever instance — see data/qlever/Qleverfile, `make
# qlever-index` / `make qlever-up`, and docs/learning_plan_sparql.md). Tests always use "memory"
# regardless of this value.
GRAPH_BACKEND="memory"
# Only used when GRAPH_BACKEND="qlever"; must match [server] PORT in data/qlever/Qleverfile.
QLEVER_ENDPOINT="http://localhost:7011"

# Neo4j backend for `uv run weather-graph-neo4j` (see PLAN_NEO4J.md). This is a separate demo
# entry point (src/weather_graph/demo_neo4j.py, fixed Cypher queries, no LLM) — it does not go
# through GRAPH_BACKEND/get_graph() and is not a third GRAPH_BACKEND value. Defaults below match
# the local container started by `make neo4j-up`. NEO4J_USERNAME (not NEO4J_USER) is required —
# this exact name is what `neo4j-cli query`'s .env auto-discovery reads (confirmed via
# `neo4j-cli query --help`), and connection.py's Python driver reads the same name.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="neo4j"
NEO4J_DATABASE="neo4j"
